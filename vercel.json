{
  "rewrites": [
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/", "destination": "/app/index.html" },
    { "source": "/app/((?!_expo/|assets/|favicon\\.ico|metadata\\.json).*)", "destination": "/app/index.html" },
    { "source": "/((?!app/|assets/|favicon\\.ico|manifest\\.webmanifest|sw\\.js).*)", "destination": "/index.html" }
  ]
}
